   ObjectSetInteger(chart, "PANEL_BG", OBJPROP_YDISTANCE, y - 5);
   ObjectSetInteger(chart, "PANEL_BG", OBJPROP_XSIZE, 240);
   ObjectSetInteger(chart, "PANEL_BG", OBJPROP_YSIZE, 205);   // Extra row for filter status
   ObjectSetInteger(chart, "PANEL_BG", OBJPROP_BGCOLOR, C'255,255,255');
   ObjectSetInteger(chart, "PANEL_BG", OBJPROP_BORDER_COLOR, C'60,60,80');
   ObjectSetInteger(chart, "PANEL_BG", OBJPROP_BORDER_TYPE, BORDER_FLAT);
   ObjectSetInteger(chart, "PANEL_BG", OBJPROP_CORNER, corner);
   ObjectSetInteger(chart, "PANEL_BG", OBJPROP_BACK, false);

   //--- Title label
   CreateLabel("LBL_TITLE", "⚡ VENOM AI_v3.2", x + 5, y + 5,
               clrGold, 10, "Arial Bold", corner);

   //--- Status label
   CreateLabel(LBL_STATUS, "● IDLE", x + 5, y + 28,
               clrSilver, 9, "Arial", corner);

   //--- Info label
   CreateLabel(LBL_INFO, "Lot: " + DoubleToString(InpLotSize, 2), x + 5, y + 48,
               clrSilver, 8, "Arial", corner);

   //--- Risk info label
   CreateLabel("LBL_RISK", "Risk: -" + DoubleToString(InpDailyLossLimit, 1) +
               "% / +" + DoubleToString(InpDailyProfitTarget, 1) + "%",
               x + 5, y + 68, clrSilver, 8, "Arial", corner);

   //--- Daily P&L label
   CreateLabel("LBL_PNL", "Daily P&L: $0.00 (0.00%)", x + 5, y + 85,
               clrSilver, 8, "Arial", corner);

   //--- Filter status label (shows which filter is blocking, or "FILTERS: OK" when clear)
   CreateLabel("LBL_FILTER", "FILTERS: OK", x + 5, y + 102,
               clrLimeGreen, 8, "Arial", corner);

   //--- START button
   CreateButton(BTN_START, "▶  START", x + 5, y + 122, 105, 28,
                clrWhite, C'0,120,60', corner);

   //--- STOP button
   CreateButton(BTN_STOP, "■  STOP", x + 120, y + 122, 105, 28,
                clrWhite, C'160,30,30', corner);

   ChartRedraw(chart);
  }

//+------------------------------------------------------------------+
//|  DASHBOARD: Remove all UI objects                                |
//+------------------------------------------------------------------+
void RemoveDashboard()
  {
   string objects[] = {"PANEL_BG","LBL_TITLE",LBL_STATUS,LBL_INFO,"LBL_RISK","LBL_PNL","LBL_FILTER",BTN_START,BTN_STOP};
   for(int i = 0; i < ArraySize(objects); i++)
      ObjectDelete(ChartID(), objects[i]);

   ChartRedraw(ChartID());
  }

//+------------------------------------------------------------------+
//|  DASHBOARD: Update status label                                  |
//+------------------------------------------------------------------+
void UpdateDashboardStatus(string text, color clr)
  {
   ObjectSetString(ChartID(), LBL_STATUS, OBJPROP_TEXT, "● " + text);
   ObjectSetInteger(ChartID(), LBL_STATUS, OBJPROP_COLOR, clr);
   ChartRedraw(ChartID());
  }

//+------------------------------------------------------------------+
//|  DASHBOARD: Update info line with live state details             |
//+------------------------------------------------------------------+
void UpdateDashboardInfo()
  {
   string stateStr = "";

   switch(g_CycleState)
     {
      case STATE_IDLE:         stateStr = "IDLE";         break;
      case STATE_PENDING:      stateStr = "PENDING";      break;
      case STATE_TRADE_ACTIVE: stateStr = "TRADE ACTIVE"; break;
      case STATE_CYCLE_DONE:   stateStr = "CYCLE DONE";   break;
     }

   string info = "Lot:" + DoubleToString(InpLotSize, 2) +
                 " | " + stateStr;

   ObjectSetString(ChartID(), LBL_INFO, OBJPROP_TEXT, info);

   //--- Update live daily P&L display
   if(g_DayStartBalance > 0)
     {
      double equity   = AccountInfoDouble(ACCOUNT_EQUITY);
      double dailyPnL = equity - g_DayStartBalance;
      double pnlPct   = (dailyPnL / g_DayStartBalance) * 100.0;
      color  pnlColor = (dailyPnL >= 0) ? clrLimeGreen : clrOrangeRed;
      string pnlText  = StringFormat("Daily P&L: $%.2f (%.2f%%)", dailyPnL, pnlPct);
      ObjectSetString (ChartID(), "LBL_PNL", OBJPROP_TEXT,  pnlText);
      ObjectSetInteger(ChartID(), "LBL_PNL", OBJPROP_COLOR, pnlColor);
     }

   //--- Update filter status label (only meaningful while idle/waiting to place)
   if(g_CycleState == STATE_IDLE && g_FilterBlockReason != "")
     {
      ObjectSetString (ChartID(), "LBL_FILTER", OBJPROP_TEXT,  "⚠ " + g_FilterBlockReason);
      ObjectSetInteger(ChartID(), "LBL_FILTER", OBJPROP_COLOR, clrOrange);
     }
   else
     {
      ObjectSetString (ChartID(), "LBL_FILTER", OBJPROP_TEXT,  "FILTERS: OK");
      ObjectSetInteger(ChartID(), "LBL_FILTER", OBJPROP_COLOR, clrLimeGreen);
     }

   ChartRedraw(ChartID());
  }

